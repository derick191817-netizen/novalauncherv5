# EXEMPLO para um repositório NOVO (o script de envio só copia este arquivo se o repositório estiver vazio).
# Se você já tem um .github/workflows/android.yml funcionando, ele NÃO é tocado.
name: Android CI
on:
  push:
    branches: [main]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'
      - uses: android-actions/setup-android@v4
      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'
      - name: Aceitar licencas e instalar SDK
        run: yes | sdkmanager "platforms;android-34" "build-tools;34.0.0" || true
      - name: Compilar APK debug
        run: gradle :app:assembleDebug --stacktrace
      - uses: actions/upload-artifact@v4
        if: success()
        with:
          name: app-debug-apk
          path: app/build/outputs/apk/debug/*.apk
          if-no-files-found: error
